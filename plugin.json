{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "chat-groups",
  "version": "2.0.1",
  "description": "Mention-aware group conversations for OpenAgent.",
  "license": "MIT",
  "repository": "https://github.com/BANG404/openagent-chat-groups",
  "keywords": ["openagent", "chat-groups", "conversation"],
  "extensions": {
    "openagent": {
      "mcp_tool_mode": "relay",
      "capabilities": ["mcp", "sidebar"],
      "sidebar": [
        {
          "id": "groups",
          "title": "Chat Groups",
          "entry": "ui/groups.html",
          "scope": "workspace",
          "icon": "users",
          "capabilities": ["workspace", "conversation", "branch", "locale", "theme"]
        }
      ],
      "i18n": {
        "supported_locales": ["en", "zh"],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "Chat Groups",
            "sidebar.groups.title": "Chat Groups",
            "description": "Mention-aware group conversations for OpenAgent.",
            "notice.conversationWorkspace": "Conversation is outside the current workspace",
            "notice.titleEmpty": "title is empty",
            "notice.contentEmpty": "content is empty",
            "notice.titleContentRequired": "title and content are required",
            "notice.unknownRole": "Unknown role '{name}'",
            "notice.conversationContentRequired": "conversation_id and content are required",
            "notice.groupMissing": "Chat group not found",
            "notice.groupWorkspace": "Chat group is outside the current workspace",
            "notice.unknownTool": "Unknown tool: {name}",
            "notice.methodMissing": "Method not found: {method}",
            "notice.dataMissing": "PLUGIN_DATA is not set",
            "notice.unexpected": "Chat Groups operation failed ({code})",
            "notice.dataUnreadable": "Chat Groups data could not be read",
            "notice.dataVersion": "Unsupported Chat Groups data version '{version}'",
            "notice.startDiscussionType": "start_discussion must be a boolean",
            "notice.rolesType": "roles must contain non-empty saved role names or IDs",
            "notice.partialGroup": "Group '{group_id}' was saved; retry with group_id to finish adding roles",
            "notice.memberOwner": "Group owner",
            "notice.memberAgent": "Agent",
            "notice.notMember": "Conversation is not a member of this chat group",
            "notice.backupFailed": "Chat Groups backup could not be saved"
          },
          "zh": {
            "display_name": "聊天群组",
            "sidebar.groups.title": "聊天群组",
            "description": "支持提及成员的 OpenAgent 群组会话。",
            "notice.conversationWorkspace": "该会话不属于当前工作区",
            "notice.titleEmpty": "标题不能为空",
            "notice.contentEmpty": "内容不能为空",
            "notice.titleContentRequired": "标题和内容均为必填项",
            "notice.unknownRole": "未知角色“{name}”",
            "notice.conversationContentRequired": "conversation_id 和 content 均为必填项",
            "notice.groupMissing": "找不到群组会话",
            "notice.groupWorkspace": "该群组不属于当前工作区",
            "notice.unknownTool": "未知工具：{name}",
            "notice.methodMissing": "找不到方法：{method}",
            "notice.dataMissing": "未设置 PLUGIN_DATA",
            "notice.unexpected": "Chat Groups 操作失败（{code}）",
            "notice.dataUnreadable": "无法读取群组数据，原文件已保留",
            "notice.dataVersion": "不支持群组数据版本“{version}”",
            "notice.startDiscussionType": "start_discussion 必须是布尔值",
            "notice.rolesType": "roles 必须包含非空的已保存角色名称或 ID",
            "notice.partialGroup": "群组“{group_id}”已保存；请传入 group_id 重试以完成添加角色",
            "notice.memberOwner": "群主",
            "notice.memberAgent": "智能体",
            "notice.notMember": "该会话不是此聊天组的成员",
            "notice.backupFailed": "无法保存群组数据备份，原文件已保留"
          }
        }
      }
    }
  }
}
